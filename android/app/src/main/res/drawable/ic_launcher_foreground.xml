<?xml version="1.0" encoding="utf-8"?>
<!--
  App mark: the "diamond ring" - a solar-eclipse ring whose stroke runs from
  violet at the top left to cyan-white at the bottom right, with a single bright
  bead (the Baily's bead / diamond) sitting on the ring at the 4:30 position.

  Adaptive-icon foreground: 108x108 viewport, and every mask crops to the inner
  72dp circle (radius 36 from the centre), so the whole mark - bead flare
  included - is kept inside that radius.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring. Diameter 52, stroke = diameter x 0.076. -->
    <path
        android:pathData="M 54,28 A 26,26 0 1 1 53.99,28 Z"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80">
                <item android:offset="0.0" android:color="#FFC04CF5" />
                <item android:offset="0.45" android:color="#FF6E6CF0" />
                <item android:offset="0.75" android:color="#FF35C8DE" />
                <item android:offset="1.0" android:color="#FF9FF3E6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bead glow, then the bead itself, at 45 degrees down-right on the ring. -->
    <path
        android:pathData="M 72.4,72.4 m -9,0 a 9,9 0 1 0 18,0 a 9,9 0 1 0 -18,0 Z"
        android:fillAlpha="0.16">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="72.4"
                android:centerY="72.4"
                android:gradientRadius="9">
                <item android:offset="0.0" android:color="#FFCFFBFF" />
                <item android:offset="1.0" android:color="#00CFFBFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Four-point flare. -->
    <path
        android:pathData="M 62.4,72.4 L 82.4,72.4 M 72.4,62.4 L 72.4,82.4"
        android:strokeColor="#E6CFFBFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 67.4,67.4 L 77.4,77.4 M 67.4,77.4 L 77.4,67.4"
        android:strokeColor="#99CFFBFF"
        android:strokeWidth="1"
        android:strokeLineCap="round" />

    <path
        android:pathData="M 72.4,72.4 m -3.2,0 a 3.2,3.2 0 1 0 6.4,0 a 3.2,3.2 0 1 0 -6.4,0 Z"
        android:fillColor="#FFF6FEFF" />
</vector>
